list: user.code_common_function
code.language: go
-

# golang builtin functions
append
base64 decode: base64.StdEncoding.DecodeString
base64 encode: base64.StdEncoding.EncodeToString
bufio new reader: bufio.NewReader
bufio new scanner: bufio.NewScanner
capacity: cap
close

complex number: complex
context background: context.Background
context todo: context.TODO
context with cancel: context.WithCancel
context with deadline: context.WithDeadline
# formatting
context with timeout: context.WithTimeout
copy
delete
errors new: errors.New
format error: fmt.Errorf
format es print eff: fmt.Sprintf
format print: fmt.Printf

# fmt helpers

format print eff: fmt.Printf

# log helpers
format print line: fmt.Println
format sprint: fmt.Sprintf
http get: http.Get
http handle func: http.HandleFunc
http listen and serve: http.ListenAndServe
http new request: http.NewRequest
http post: http.Post
i o copy: io.Copy

# strings helpers
i o read all: io.ReadAll
imag part: imag
int to string: strconv.Itoa
json marshal: json.Marshal
json unmarshal: json.Unmarshal
length: len
log fatal: log.Fatal
log fatal f: log.Fatalf
log fatal line: log.Fatalln

# strconv helpers
log panic: log.Panic
log panic f: log.Panicf
log panic line: log.Panicln
log print: log.Print

# encoding helpers
log print line: log.Println
make
math random float: rand.Float64
math random int: rand.Intn

# context helpers
math random seed: rand.Seed
new
panic
print
print line: println

# http helpers
real part: real
recover
string contains: strings.Contains
string convert to bool: strconv.ParseBool
string convert to float: strconv.ParseFloat

# bufio / io helpers
string convert to int: strconv.Atoi
string has prefix: strings.HasPrefix
string has suffix: strings.HasSuffix
string join: strings.Join

# math rand helpers
string repeat: strings.Repeat
string split: strings.Split
string to lower: strings.ToLower

# errors
string to upper: strings.ToUpper

# time helpers
string trim: strings.TrimSpace
time duration: time.Duration
time hour: time.Hour
# time
time microsecond: time.Microsecond
time millisecond: time.Millisecond
time minute: time.Minute
time nanosecond: time.Nanosecond
time new ticker: time.NewTicker
time new timer: time.NewTimer
time now: time.Now
time second: time.Second
time since: time.Since
time tick: time.Tick
time until: time.Until
