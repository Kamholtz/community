language: go
---

name: packageMainDeclaration
description: insert the main package declaration block
phrase: package main
insertionScope: statement
-
package main
---

name: packageDeclaration
description: declare a named Go package
phrase: package declaration
insertionScope: statement
-
package $0
---

name: importBlock
description: create a grouped import block
phrase: import block
insertionScope: statement
-
import (
    $0
)
---

name: singleImport
description: import a single package
phrase: import statement
insertionScope: statement
-
import "$0"
---

name: mainFunction
description: stub out the canonical main function
phrase: main function
insertionScope: namedFunction
-
func main() {
    $0
}
---

name: functionDeclaration
description: declare a named function
phrase: function declaration
insertionScope: namedFunction
-
func $1($2) $3 {
    $0
}
---

name: methodDeclaration
description: declare a method with a pointer receiver
phrase: method declaration
insertionScope: namedFunction
-
func ($1 *$2) $3($4) $5 {
    $0
}
---

name: structDeclaration
description: declare a struct type
phrase: struct declaration
insertionScope: statement
-
type $1 struct {
    $0
}
---

name: interfaceDeclaration
description: declare an interface
phrase: interface declaration
insertionScope: statement
-
type $1 interface {
    $0
}
---

name: ifStatement
description: insert a simple if statement
phrase: if statement
insertionScope: statement
-
if $1 {
    $0
}
---

name: ifElseStatement
description: insert an if/else block
phrase: if else block
insertionScope: statement
-
if $1 {
    $2
} else {
    $0
}
---

name: forLoop
description: insert a flexible for loop
phrase: for loop
insertionScope: statement
-
for $1 {
    $0
}
---

name: rangeLoop
description: iterate over a collection with range
phrase: range loop
insertionScope: statement
-
for $1, $2 := range $3 {
    $0
}
---

name: switchStatement
description: insert a switch statement with a default case
phrase: switch statement
insertionScope: statement
-
switch $1 {
case $2:
    $3
default:
    $0
}
---

name: selectStatement
description: build a select statement with a default case
phrase: select statement
insertionScope: statement
-
select {
case $1 <- $2:
    $3
default:
    $0
}
---

name: backgroundRoutine
description: spawn a goroutine with an anonymous function
phrase: background routine
insertionScope: statement
-
go func() {
    $0
}()
---

name: deferStatement
description: defer a function call
phrase: defer statement
insertionScope: statement
-
defer $0
---

name: printlnCall
description: emit a fmt.Println call
phrase: println call
insertionScope: statement
-
fmt.Println($0)
---

name: errorCheckGuard
description: guard against a non-nil error
phrase: error check
insertionScope: statement
-
if err != nil {
    return $0
}
---

name: mapLiteral
description: define a map literal
phrase: map literal
insertionScope: statement
-
map[$1]$2{
    $0
}
---
