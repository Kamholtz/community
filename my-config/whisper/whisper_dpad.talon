tag: user.whisper_dpad
-

# Direction keys and the physical D-pad share the same data-driven dispatcher.
key(up): user.whisper_dpad_dispatch("up")
key(left): user.whisper_dpad_dispatch("left")
key(right): user.whisper_dpad_dispatch("right")
key(down): user.whisper_dpad_dispatch("down")

gamepad(dpad_up:down): user.whisper_dpad_dispatch("up")
gamepad(dpad_left:down): user.whisper_dpad_dispatch("left")
gamepad(dpad_right:down): user.whisper_dpad_dispatch("right")
gamepad(dpad_down:down): user.whisper_dpad_dispatch("down")

# Known non-direction controls dismiss the overlay rather than reaching the app.
key(escape): user.whisper_dpad_hide()
key(enter): user.whisper_dpad_hide()
key(space): user.whisper_dpad_hide()
key(tab): user.whisper_dpad_hide()
key(backspace): user.whisper_dpad_hide()
key(delete): user.whisper_dpad_hide()
key(home): user.whisper_dpad_hide()
key(end): user.whisper_dpad_hide()
key(pageup): user.whisper_dpad_hide()
key(pagedown): user.whisper_dpad_hide()
